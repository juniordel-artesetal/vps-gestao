# Copie para .env no VPS (cp env.exemplo .env) (NUNCA commitar o .env).
# Segredo compartilhado com o SOA (o mesmo valor vai em WHATSAPP_SERVICE_SECRET na Vercel). Mínimo 24 caracteres:
#   openssl rand -hex 32
WHATSAPP_SERVICE_SECRET=
PORT=3080
# Para onde vão os "PARAR" (opt-out):
SOA_ENTRADA_URL=https://www.usesoa.com.br/api/whatsapp/entrada
# Espera aleatória entre envios (anti-ban), em segundos:
ENVIO_MIN_S=5
ENVIO_MAX_S=15
FILA_MAX=500
# Pasta da sessão (faça backup dela — sem ela, precisa escanear o QR de novo):
SESSAO_DIR=./.wwebjs_auth
# Chromium do sistema (opcional; sem isto usa o que o Puppeteer baixou):
# CHROME_PATH=/usr/bin/chromium
